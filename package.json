{
  "name": "mcp-directory",
  "version": "1.0.0",
  "description": "Directory page for the MCP servers hosted on mcp.joshuamarble.io — a tiny Cloudflare Worker on the hostname's catch-all route",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "tsc --noEmit && tsc -p test --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  },
  "allowScripts": {
    "workerd@1.20260708.1": true,
    "sharp@0.34.5": true,
    "esbuild@0.28.1": true
  }
}
